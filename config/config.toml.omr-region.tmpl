# >>> oh-my-research (managed) >>>
# 이 영역은 oh-my-research 설치 프로그램이 관리합니다.
# 이 센티넬 사이를 편집하지 마세요 — install.sh/install.ps1을 다시 실행하면
# 재생성됩니다. 개인 설정은 이 영역 밖에서 편집하세요.
#
# 테이블 전용 영역입니다 (위치 무관 — 파일 끝에 추가됩니다).
# 루트 스칼라 키(sandbox_mode/approval_policy)는 별도의
# oh-my-research:root 영역(파일 상단)에서 관리됩니다 (A6 수정).

[sandbox_workspace_write]
# 렌더링 중간 결과물 저장을 위해 tmp는 쓰기 가능 상태를 유지해야 합니다.
# 아래는 기본값이며 명시적으로 여기에 선언합니다 — true로 설정하지 마세요.
exclude_slash_tmp = false
exclude_tmpdir_env_var = false
# writable_roots는 MVP에서 작성하지 않습니다 (post-MVP renv/TinyTeX 탈출구).

[mcp_servers.omr_scholar]
command = "@@VENV_PY@@"
args    = ["-m", "omr_scholar.server"]

[mcp_servers.omr_scholar.env]
OMR_SCHOLAR_MAILTO = "@@OMR_SCHOLAR_MAILTO@@"

[mcp_servers.omr_render]
command = "@@VENV_PY@@"
args    = ["-m", "omr_render.server"]

# <<< oh-my-research (managed) <<<
